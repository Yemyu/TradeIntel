!/docs/PUBLIC_SHOWCASE.zh-CN.md
!/docs/TESTING.md
!/docs/TESTING.zh-CN.md
!/docs/MODEL_SELECTION.md
!/docs/MODEL_SELECTION.zh-CN.md
!/docs/USAGE.zh-CN.md
!/docs/AGENT_REVIEWER_QUICKSTART.zh-CN.md
!/docs/releases/
/docs/releases/*
!/docs/releases/showcase-20261002.md
!/docs/releases/SHA256SUMS-20261002.txt

